                                                </li>
                                                <li class="card-product__data">
                                                    <div class="card-product__icon">
                                                        <svg aria-hidden="true" width="10" height="12">
                                                            <use xlink:href="img/sprite.svg#flag"></use>
                                                        </svg>
                                                    </div>
