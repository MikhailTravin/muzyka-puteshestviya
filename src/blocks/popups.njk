<div id="price" aria-hidden="true" class="popup popup-forms">
    <div class="popup__wrapper">
        <div class="popup__content">
            <div data-close class="popup__close">
                <svg aria-hidden="true" width="11" height="11">
                    <use xlink:href="img/sprite.svg#close"></use>
                </svg>
            </div>
            <div class="popup-forms__body">
                <div class="popup-forms__top">
                    <div class="popup-forms__title">
                        Рассчитать стоимость
                    </div>
                </div>
                <form data-popup-message="#thanks" method="POST" action="#" data-dev class="form-price">
                    <div class="form-price__inputs">
                        <div class="form-price__input">
                            <div class="form-price__label">Кто едет?</div>
                            <div class="form-price__chekboxes">
                                <label class="checkbox">
                                    <input checked class="checkbox__input" type="checkbox" value="1" name="checkbox1">
                                    <span class="checkbox__label">
                                        <span class="checkbox__icon">
                                            <svg aria-hidden="true" width="13" height="12">
                                                <use xlink:href="img/sprite.svg#check1"></use>
                                            </svg>
                                        </span>
                                        <span class="checkbox__text">Школьники</span>
                                    </span>
                                </label>
                                <label class="checkbox">
                                    <input class="checkbox__input" type="checkbox" value="2" name="checkbox1">
                                    <span class="checkbox__label">
                                        <span class="checkbox__icon">
                                            <svg aria-hidden="true" width="13" height="12">
                                                <use xlink:href="img/sprite.svg#check1"></use>
                                            </svg>
                                        </span>
                                        <span class="checkbox__text">Взрослые</span>
                                    </span>
                                </label>
                            </div>
                        </div>
                        <div class="form-price__input">
                            <div class="form-price__label">Дата поездки:</div>
                            <div class="form-calendar">
                                <div class="form-calendar__input">
                                    <input readonly data-required autocomplete="off" type="text" class="input-calendar"
                                        name="form[]" placeholder="Выбрать дату">
                                    <svg aria-hidden="true" width="20" height="20">
                                        <use xlink:href="img/sprite.svg#calendar"></use>
                                    </svg>
                                </div>
                                <div class="calendar">
                                    <div class="calendar__content">
                                        <div class="calendar__header">
                                            <button type="button" class="calendar__btn-prev calendar-btn">
                                                <svg aria-hidden="true" width="10" height="14">
                                                    <use xlink:href="img/sprite.svg#arrow1"></use>
                                                </svg>
                                            </button>
                                            <span></span>
                                            <button type="button" class="calendar__btn-next calendar-btn">
                                                <svg aria-hidden="true" width="10" height="14">
                                                    <use xlink:href="img/sprite.svg#arrow1"></use>
                                                </svg>
                                            </button>
                                        </div>
                                        <div class="calendar__wrapper">
                                            <div class="calendar__days">
                                                <div class="cell_wrapper cal_days"><span class="cell_item">Пн</span>
                                                </div>
                                                <div class="cell_wrapper cal_days"><span class="cell_item">Вт</span>
                                                </div>
                                                <div class="cell_wrapper cal_days"><span class="cell_item">Ср</span>
                                                </div>
                                                <div class="cell_wrapper cal_days"><span class="cell_item">Чт</span>
                                                </div>
                                                <div class="cell_wrapper cal_days"><span class="cell_item">Пт</span>
                                                </div>
                                                <div class="cell_wrapper cal_days"><span class="cell_item">Сб</span>
                                                </div>
                                                <div class="cell_wrapper cal_days"><span class="cell_item">Вс</span>
                                                </div>
                                            </div>
                                            <div class="calendar__main"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="form-price__input">
                            <div class="form-price__label">Кол-во человек:</div>
                            <div data-quantity class="quantity">
                                <button data-quantity-minus type="button"
                                    class="quantity__button quantity__button_minus">
                                    <span></span>
                                </button>
                                <div class="quantity__input">
                                    <input data-quantity-value autocomplete="off" type="text" name="form[]" value="1">
                                </div>
                                <button data-quantity-plus type="button" class="quantity__button quantity__button_plus">
                                    <span></span>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="form-price__bottom">
                        <label class="checkbox2">
                            <input data-required class="checkbox2__input" type="checkbox" value="1" name="checkbox2">
                            <span class="checkbox2__label">
                                <span class="checkbox2__icon">
                                    <svg aria-hidden="true" width="12" height="11">
                                        <use xlink:href="img/sprite.svg#check1"></use>
                                    </svg>
                                </span>
                                <span class="checkbox2__text">
                                    Я согласен с <a href="./">Правилами возврата</a> и <a href="./">Политикой обработки
                                        персональных данных</a>
                                </span>
                            </span>
                        </label>
                        <button type="submit" class="btn btn-blue">
                            <img src="img/icons/calculator.svg" alt="">
                            <span>Рассчитать стоимость тура</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div id="thanks" aria-hidden="true" class="popup popup-forms">
    <div class="popup__wrapper">
        <div class="popup__content">
            <div data-close class="popup__close">
                <svg aria-hidden="true" width="16" height="16">
                    <use xlink:href="img/sprite.svg#close"></use>
                </svg>
            </div>
            <div class="popup-forms__body">
                <div class="popup-forms__top">
                    <div class="popup-forms__title">Спасибо за заявку!</div>
                    <p>
                        Свяжимся с вами в ближайшее время.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>