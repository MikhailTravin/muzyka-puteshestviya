<!DOCTYPE html>
<html lang="ru">

<head>
    <title>Отзывы</title>
    {% include 'blocks/head.njk' %}
</head>

<body class="preload mp">
    <div class="main-wrapper-outer">
        {% include 'blocks/header.njk' %}
        <main class="main">

            <div class="block-intro block-intro-other block-intro-reviews">
                <img src="img/image23.webp" alt="" class="block-intro__bg1">
                <div class="container">
                    <div class="block-intro__content">
                        <div class="breadcrumbs">
                            <ul>
                                <li>
                                    <a href="#" class="home">
                                        <img src="img/icons/home.svg" alt="">
                                    </a>
                                </li>
                                <li><span>Отзывы</span></li>
                            </ul>
                        </div>
                        <div class="block-intro__body">
                            <div class="block-intro__titles">
                                <h1 class="title1">
                                    Отзывы наших путешественников и партнеров
                                </h1>
                                <p>
                                    Мы гордимся тем, что нам доверяют организацию отдыха индивидуальные туристы,
                                    школьные группы и туристические агентства со всей России
                                </p>
                            </div>
                            <div class="block-intro-rating">
                                <div class="block-intro-rating__body">
                                    <div class="block-intro-rating__columns">
                                        <div class="block-intro-rating__column">
                                            <div class="block-intro-rating__number">
                                                <img src="img/icons/star.svg" alt="">
                                                <span>4.9</span>
                                            </div>
                                            <div class="block-intro-rating__text">
                                                на Яндекс.Картах
                                            </div>
                                        </div>
                                        <div class="block-intro-rating__column">
                                            <div class="block-intro-rating__number">
                                                <img src="img/icons/star.svg" alt="">
                                                <span>5.0</span>
                                            </div>
                                            <div class="block-intro-rating__text">
                                                на Google Отзывах
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <a href="./" data-goto=".block-forms-reviews" data-goto-header class="btn">
                                    <span>Оставить отзыв</span>
                                    <div class="btn__icon">
                                        <svg aria-hidden="true" width="6" height="8">
                                            <use xlink:href="img/sprite.svg#arrow1"></use>
                                        </svg>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="block-reviews block3">
                <div class="container">
                    <div class="block-reviews__content">
                        <div class="block-reviews__cards">
                            <div class="card-review">

                            </div>
                        </div>
                        <button type="button" class="btn">
                            <span>Показать еще отзывы</span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="block-letters block1">
                <div class="container">
                    <h2 class="title2">
                        Официальные благодарственные письма
                    </h2>
                    <div class="block-letters__content">
                        <div class="block-letters__body">
                            <div class="block-letters__column">
                                <a href="img/letters/image1.webp" data-fancybox="gallery5" class="block-letters__image">
                                    <img loading="lazy" src="img/letters/image1.webp" alt="">
                                </a>
                                <div class="block-letters__title">
                                    Благодарность от ГБОУ СОШ №123, г. Москва
                                </div>
                            </div>
                            <div class="block-letters__column">
                                <a href="img/letters/image2.webp" data-fancybox="gallery5" class="block-letters__image">
                                    <img loading="lazy" src="img/letters/image2.webp" alt="">
                                </a>
                                <div class="block-letters__title">
                                    Благодарность от ГБОУ СОШ №123, г. Москва
                                </div>
                            </div>
                            <div class="block-letters__column">
                                <a href="img/letters/image3.webp" data-fancybox="gallery5" class="block-letters__image">
                                    <img loading="lazy" src="img/letters/image3.webp" alt="">
                                </a>
                                <div class="block-letters__title">
                                    Благодарность от ГБОУ СОШ №123, г. Москва
                                </div>
                            </div>
                            <div class="block-letters__column">
                                <a href="img/letters/image4.webp" data-fancybox="gallery5" class="block-letters__image">
                                    <img loading="lazy" src="img/letters/image4.webp" alt="">
                                </a>
                                <div class="block-letters__title">
                                    Благодарность от ГБОУ СОШ №123, г. Москва
                                </div>
                            </div>
                            <div class="block-letters__column">
                                <a href="img/letters/image5.webp" data-fancybox="gallery5" class="block-letters__image">
                                    <img loading="lazy" src="img/letters/image5.webp" alt="">
                                </a>
                                <div class="block-letters__title">
                                    Благодарность от ГБОУ СОШ №123, г. Москва
                                </div>
                            </div>
                            <div class="block-letters__column">
                                <a href="img/letters/image4.webp" data-fancybox="gallery5" class="block-letters__image">
                                    <img loading="lazy" src="img/letters/image4.webp" alt="">
                                </a>
                                <div class="block-letters__title">
                                    Благодарность от ГБОУ СОШ №123, г. Москва
                                </div>
                            </div>
                            <div class="block-letters__column">
                                <a href="img/letters/image1.webp" data-fancybox="gallery5" class="block-letters__image">
                                    <img loading="lazy" src="img/letters/image1.webp" alt="">
                                </a>
                                <div class="block-letters__title">
                                    Благодарность от ГБОУ СОШ №123, г. Москва
                                </div>
                            </div>
                            <div class="block-letters__column">
                                <a href="img/letters/image2.webp" data-fancybox="gallery5" class="block-letters__image">
                                    <img loading="lazy" src="img/letters/image2.webp" alt="">
                                </a>
                                <div class="block-letters__title">
                                    Благодарность от ГБОУ СОШ №123, г. Москва
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn">
                            <span>Показать еще письма</span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="block-forms1 block-forms-reviews">
                <div class="container">
                    <div class="block-forms1__content">
                        <div class="block-forms1__left">
                            <div class="heading-complex">
                                <h2 class="title2 title2-white">
                                    Поделитесь своими впечатлениями
                                </h2>
                                <p>
                                    Ваш отзыв поможет другим путешественникам сделать правильный выбор, а нам — стать
                                    еще лучше
                                </p>
                            </div>
                        </div>
                        <form data-dev data-popup-message="#thanks" action="#" class="form">
                            <div class="form__body">
                                <div class="form__inputs">
                                    <div class="form__inputs3">
                                        <div class="form__input">
                                            <input autocomplete="off" type="text" name="form[]" placeholder="Ваше имя"
                                                class="input">
                                        </div>
                                        <div class="form__input">
                                            <input data-required autocomplete="off" type="text" name="form[]"
                                                placeholder="Город" class="input">
                                        </div>
                                        <div class="form__input">
                                            <div class="form-file">
                                                <input type="file">
                                                <div class="form-file__title">
                                                    Прикрепить фото
                                                </div>
                                                <div class="form-file__icon">
                                                    <svg aria-hidden="true" width="20" height="19">
                                                        <use xlink:href="img/sprite.svg#pin"></use>
                                                    </svg>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form__inputs2">
                                        <div class="form__input">
                                            <select name="form[]" class="select">
                                                <option value="1" selected>Какой тур/экскурсию вы посетили?</option>
                                                <option value="2">Пункт №2</option>
                                                <option value="3">Пункт №3</option>
                                                <option value="4">Пункт №4</option>
                                            </select>
                                        </div>
                                        <div class="form-rating">
                                            <div class="form-rating__text">
                                                Ваша оценка:
                                            </div>
                                            <div data-rating="set" data-rating-size="5" data-rating-value="0"
                                                class="rating">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="form__bottom">
                                    <div class="form__input">
                                        <textarea data-required placeholder="Текст отзыва"
                                            class="input textarea"></textarea>
                                    </div>
                                    <button type="submit" class="btn">
                                        <span>Отправить отзыв</span>
                                        <div class="btn__icon">
                                            <svg aria-hidden="true" width="6" height="8">
                                                <use xlink:href="img/sprite.svg#arrow1"></use>
                                            </svg>
                                        </div>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

        </main>
        {% include 'blocks/footer.njk' %}
    </div>
    {% include 'blocks/popups.njk' %}
    {% include 'blocks/scripts.njk' %}
</body>

</html>